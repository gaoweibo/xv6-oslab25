index 0000000..d7e958c
--- /dev/null
+++ b/user/yieldtest.c
@@ -0,0 +1,29 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+void yieldtest(void) {
+  printf("yield test\n");
+
+  for (int i = 0; i < 3; i++) {
+    int pid = fork();
+    if (pid == 0) {
+      printf("Child with PID %d begins to run\n", getpid());
+      exit(0);
+    } else {
+    }
+  }
+  printf("parent yield\n");
+  // yield之后
+  // 在单核情况下，调度器应当调度到子进程
+  yield();
+  printf("parent yield finished\n");
+  for (int i = 0; i < 3; i++) {
+    wait(0, 0);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  yieldtest();
+  exit(0);
+}
